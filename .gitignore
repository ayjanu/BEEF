# ============================================================================
# Beefmobile Monorepo - Git Ignore
# ============================================================================

# ============================================================================
# Dependencies
# ============================================================================

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Go
vendor/
*.exe
*.exe~
*.dll
*.so
*.dylib

# ============================================================================
# Build Outputs
# ============================================================================

# Frontend
frontend/dist/
frontend/build/
frontend/.vite/
frontend/.next/
frontend/out/

# Go binaries
services/matchmaking/bin/
services/matchmaking/cmd/server/server
services/*/bin/
*.test
*.out

# CDK
infrastructure/cdk/cdk.out/
infrastructure/cdk/*.js
infrastructure/cdk/*.d.ts
infrastructure/cdk/*.js.map

# Shared packages
shared/*/dist/
shared/*/build/
shared/*/lib/

# ============================================================================
# Environment & Configuration
# ============================================================================

# Environment variables
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local

# AWS
.aws/
aws-exports.js

# Terraform (if ever used)
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# ============================================================================
# IDE & Editor
# ============================================================================

# VSCode
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
*.code-workspace

# JetBrains (WebStorm, GoLand, IntelliJ)
.idea/
*.iml
*.iws
*.ipr

# Sublime
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.*.swp

# Emacs
*~
\#*\#
.\#*

# ============================================================================
# Operating System
# ============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
.directory
.Trash-*
.nfs*

# ============================================================================
