# Local development settings for docker compose.
# Run `npm run keys:dev` to copy this to .env with real generated keys.

# ES256 keypair, PEM with newlines escaped as \n. Core API signs; every service verifies.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Shared secret for service-to-service calls inside the cluster (Silver: replaced by workload identity).
INTERNAL_TOKEN=

# Keyed hash for phone numbers (never stored in plaintext).
PII_HASH_KEY=

# Phoenix cookie/session signing key for the chat service (64+ chars).
SECRET_KEY_BASE=

# Dev-only stand-in for SMS one-time codes. NEVER set in staging or production.
DEV_OTP_CODE=000000

# Base image registry for Dockerfiles (Docker Hub rate limits are avoided by using the AWS mirror).
BASE_REGISTRY=public.ecr.aws/docker/library
