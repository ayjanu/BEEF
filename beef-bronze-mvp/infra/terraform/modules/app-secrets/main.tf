# Application secrets, generated by Terraform and stored in AWS Secrets Manager
# (the system of record). The k8s stack copies them into Kubernetes Secrets.

variable "name" { type = string }

resource "tls_private_key" "jwt" {
  algorithm   = "ECDSA"
  ecdsa_curve = "P256" # ES256: core-api signs; every service verifies with the public key
}

resource "random_password" "internal_token" {
  length  = 48
  special = false
}

resource "random_password" "pii_hash_key" {
  length  = 64
  special = false
}

resource "random_password" "chat_secret_key_base" {
  length  = 64
  special = false
}

resource "aws_secretsmanager_secret" "app" {
  name                    = "${var.name}/app"
  description             = "BEEF application secrets (JWT keys, internal token, PII hash key, chat key base)"
  recovery_window_in_days = 7
}

resource "aws_secretsmanager_secret_version" "app" {
  secret_id = aws_secretsmanager_secret.app.id
  secret_string = jsonencode({
    JWT_PRIVATE_KEY = tls_private_key.jwt.private_key_pem_pkcs8
    JWT_PUBLIC_KEY  = tls_private_key.jwt.public_key_pem
    INTERNAL_TOKEN  = random_password.internal_token.result
    PII_HASH_KEY    = random_password.pii_hash_key.result
    SECRET_KEY_BASE = random_password.chat_secret_key_base.result
  })
}

output "secret_arn" { value = aws_secretsmanager_secret.app.arn }
output "secret_name" { value = aws_secretsmanager_secret.app.name }
