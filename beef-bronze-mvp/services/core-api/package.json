{
  "name": "@beef/core-api",
  "version": "0.1.0",
  "private": true,
  "description": "BEEF Core API (NestJS): auth, profiles, swipe, threads, challenges, sessions, results, economy, leaderboards",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "node --test --experimental-transform-types --no-warnings test/*.test.ts"
  },
  "dependencies": {
    "@beef/contracts": "0.1.0",
    "@beef/game-rules": "0.1.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "ioredis": "^5.6.0",
    "jose": "^6.1.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "typescript": "~6.0.3"
  }
}
