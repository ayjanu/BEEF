{
  "name": "@beef/game-engine",
  "version": "0.1.0",
  "private": true,
  "description": "BEEF game engine: hosts server-authoritative game sessions over WebSockets",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "node --test --experimental-transform-types --no-warnings test/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.900.0",
    "@aws-sdk/lib-dynamodb": "^3.900.0",
    "@beef/contracts": "0.1.0",
    "@beef/game-rules": "0.1.0",
    "ioredis": "^5.6.0",
    "jose": "^6.1.0",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.0",
    "typescript": "~6.0.3"
  }
}
