# Server Configuration
PORT=8081
NODE_ENV=development

# AWS Configuration
AWS_REGION=us-east-1
DYNAMODB_GAME_SESSIONS_TABLE=game-sessions
DYNAMODB_GAME_ACTIONS_TABLE=game-actions
S3_REPLAYS_BUCKET=beefmobile-replays
SQS_MATCH_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/match-queue
SNS_GAME_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:game-events

# JWT Configuration
JWT_ISSUER=beefmobile-auth
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Game Configuration
GAME_TICK_RATE=60
GAME_MAX_SESSION_DURATION_MINUTES=60
GAME_INACTIVITY_TIMEOUT_SECONDS=300

# WebSocket Configuration
WS_PING_INTERVAL=30000
WS_PING_TIMEOUT=5000

# Logging
LOG_LEVEL=info
