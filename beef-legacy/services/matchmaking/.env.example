# Server Configuration
PORT=8080
ENV=development

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# AWS Configuration
AWS_REGION=us-east-1
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:matchmaking-events

# JWT Configuration
JWT_SECRET=your-jwt-secret-here
JWT_ISSUER=beefmobile-auth

# Matchmaking Configuration
MATCHMAKING_INTERVAL_SECONDS=2
MATCHMAKING_MMR_TOLERANCE=100
MATCHMAKING_MAX_WAIT_TIME_SECONDS=120
MATCHMAKING_ACCEPT_TIMEOUT_SECONDS=30

# Logging
LOG_LEVEL=info
